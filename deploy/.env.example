# Copy this file to deploy/.env (gitignored) and fill in real values.
# Do not commit deploy/.env.
#
# AWS keys are optional. aws CLI uses ~/.aws/credentials (or AWS_PROFILE)
# by default. Uncomment the lines below only to override that.

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-south-1

S3_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
