# Shared dev-team target (AWS dev backend). Trailing /accounts is the user-service
# context path. Used automatically by `npm run dev`
# when no .env.local override exists, and explicitly by `npm run build:dev`.
# Override for your own machine in .env.local instead of editing this file.
# NEXT_PUBLIC_API_URL=http://leads-services.aws.local:8082/accounts
NEXT_PUBLIC_API_URL=http://demo-services.bizloandev.linux
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lf3UKotAAAAAC4tUTgAXR-DfnyKJqgHcALvhuP7

# Dev-only tooling (e.g. /dev/form-playground). Never set this in .env.uat/.env.prod.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=false